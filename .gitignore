.pub/
build/
coverage/
config/*.local.json

# IDE and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Generated signing and secrets
supabase/.branches/
supabase/.temp/
android/key.properties
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore
*.p12
key.properties
# Environment files, Apple keys and profiles, PEM keys and release define
# files. Example files stay trackable.
.env
.env.*
!.env*.example
*.p8
*.mobileprovision
*.pem
config/dart_defines.*.json
!config/dart_defines.example.json
*.hprof
# Google Play service-account keys, in case one is copied into the tree by
# mistake. The key belongs outside the repository (docs/PLAY_RELEASE.md).
play-key*.json
*[-_.]play-key*.json
play-store-key*.json
*[-_.]play-store-key*.json
*service-account*.json
*service_account*.json
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/

# Generated local runner files can be recreated with tool/setup_*.

# tether_ui (TH-906): PNG renders are not committed (P-18); regenerate them
# with tether_ui/generator/build_all.py --images. Python caches and the
# package lock file stay untracked: the generator deletes and recreates
# tether_ui/flutter/ on every run, and the package has no third-party deps.
tether_ui/screens/png/
tether_ui/screens/sheets/
tether_ui/flows/png/
tether_ui/screens/**/*.png
tether_ui/flows/**/*.png
tether_ui/**/__pycache__/
tether_ui/flutter/pubspec.lock
