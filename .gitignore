# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
config/*.local.json

# IDE and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Generated signing and secrets
supabase/.branches/
supabase/.temp/
android/key.properties
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore
*.p12
key.properties
# Environment files, Apple keys and profiles, PEM keys and release define
# files. Example files stay trackable.
.env
.env.*
!.env*.example
*.p8
private_keys/
*.mobileprovision
*.pem
config/dart_defines.*.json
!config/dart_defines.example.json
*.hprof
# Google Play service-account keys, in case one is copied into the tree by
# mistake. The key belongs outside the repository (docs/PLAY_RELEASE.md).
play-key*.json
*[-_.]play-key*.json
play-store-key*.json
*[-_.]play-store-key*.json
*service-account*.json
*service_account*.json
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/

# Generated local runner files can be recreated with tool/setup_*.

# tether_ui (TH-906): PNG renders are not committed (P-18); regenerate them
# with specs-and-design/tether_ui/generator/build_all.py --images. Python caches and the
# package lock file stay untracked: the generator deletes and recreates
# specs-and-design/tether_ui/flutter/ on every run, and the package has no third-party deps.
specs-and-design/tether_ui/screens/png/
specs-and-design/tether_ui/screens/sheets/
specs-and-design/tether_ui/flows/png/
specs-and-design/tether_ui/screens/**/*.png
specs-and-design/tether_ui/flows/**/*.png
specs-and-design/tether_ui/**/__pycache__/
specs-and-design/tether_ui/flutter/pubspec.lock

# Fastlane store credentials. Every one of these is a key that can publish as
# us, so none of them belongs in the repository. See docs/releasing.md.
AuthKey_*.p8
*.p8
play-service-account*.json
*.mobileprovision
*.cer
*.certSigningRequest
fastlane/.env*
ios/fastlane/.env*
android/fastlane/.env*

# Fastlane run artefacts
fastlane/report.xml
ios/fastlane/report.xml
android/fastlane/report.xml
fastlane/Preview.html
ios/fastlane/Preview.html
android/fastlane/Preview.html
fastlane/test_output/
ios/fastlane/test_output/
android/fastlane/test_output/
