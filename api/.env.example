NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anonymous-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated
RECENT_AUTH_MAX_AGE_SECONDS=600
REQUEST_BODY_LIMIT_BYTES=65536
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Proxy hops to trust for client IPs (false or 0-10). Defaults to 0 in every
# environment. Set it above 0 only after confirming the real proxy count in
# front of the service; too high a value lets clients forge their IP.
TRUST_PROXY=0
CORS_ALLOWED_ORIGINS=
