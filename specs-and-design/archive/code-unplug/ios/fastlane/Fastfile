# Tether Health — iOS release lanes
#
# Run from the `ios/` directory:
#
#     fastlane beta        # signed IPA -> TestFlight
#     fastlane release     # signed IPA -> App Store Connect, submitted for review
#
# Everything credential-shaped comes from the environment. Nothing in this file
# is a secret and nothing in this file should ever become one — see
# docs/releasing.md for the full variable list.
#
# ---------------------------------------------------------------------------
# Read this before your first run
# ---------------------------------------------------------------------------
# The Xcode project is NOT currently in a state that can produce an App Store
# build, and no lane here can fix that for you, because the fix belongs in
# ios/Runner.xcodeproj/project.pbxproj:
#
#   1. No DEVELOPMENT_TEAM is set on any target.
#   2. All three extensions (UnplugMonitor, UnplugShield, UnplugShieldAction)
#      carry CODE_SIGNING_ALLOWED = NO and CODE_SIGNING_REQUIRED = NO in every
#      build configuration. Unsigned extensions cannot be distributed.
#
# `preflight` below detects both and tells you exactly what to change. Details
# and the manual steps are in docs/releasing.md ("Xcode project prerequisites").

require "shellwords"
require "fileutils"
require "tmpdir"

default_platform(:ios)

# The four signable targets, verified against the pbxproj. Order matters only
# for readability; the host app must exist in this list for `deliver`/`pilot`.
HOST_APP_IDENTIFIER = "com.TetherHealthLLC.tetherhealth".freeze

APP_IDENTIFIERS = [
  HOST_APP_IDENTIFIER,
  "com.TetherHealthLLC.tetherhealth.unplugmonitor",
  "com.TetherHealthLLC.tetherhealth.unplugshield",
  "com.TetherHealthLLC.tetherhealth.unplugshieldaction"
].freeze

# Extension target name => build settings that block distribution.
EXTENSION_TARGETS = %w[UnplugMonitor UnplugShield UnplugShieldAction].freeze

FLUTTER_PROJECT_DIR = File.expand_path("../..", __dir__).freeze
PBXPROJ_PATH = File.join(FLUTTER_PROJECT_DIR, "ios", "Runner.xcodeproj", "project.pbxproj").freeze

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Resolve the Flutter binary and fail loudly rather than letting a lane fall
# over three steps later with "command not found".
def flutter_bin
  @flutter_bin ||= begin
    candidate = ENV["FLUTTER_BIN"].to_s.empty? ? "flutter" : ENV["FLUTTER_BIN"]
    resolved = `command -v #{Shellwords.escape(candidate)} 2>/dev/null`.to_s.strip

    if resolved.empty?
      UI.user_error!(<<~MSG)
        flutter was not found on PATH.

        Looked for: #{candidate}
        PATH:       #{ENV['PATH']}

        These lanes deliberately shell out to the Flutter tool instead of
        reimplementing the build, so there is nothing sensible to fall back to.

        Fix one of these:
          * install Flutter and put its bin/ directory on PATH, or
          * export FLUTTER_BIN=/absolute/path/to/flutter

        On CI, remember that a PATH exported in one step is usually not
        visible to the next one.
      MSG
    end

    UI.message("Using flutter at #{resolved}")
    resolved
  end
end

# Run a flutter subcommand from the Flutter project root (one level above ios/).
def flutter!(args)
  Dir.chdir(FLUTTER_PROJECT_DIR) do
    sh(%(#{Shellwords.escape(flutter_bin)} #{args}))
  end
end

def require_env!(*names)
  missing = names.reject { |n| ENV[n].to_s.strip != "" }
  return if missing.empty?

  UI.user_error!(<<~MSG)
    Missing required environment variable(s): #{missing.join(', ')}

    See docs/releasing.md for what each one is and where to get it.
  MSG
end

# App Store Connect API key auth. Apple ID + password is not an option here:
# 2FA makes it unusable unattended, and a session cookie expires in a month.
#
# Two ways to supply the .p8:
#   ASC_KEY_P8_PATH    absolute path to the AuthKey_XXXX.p8 file, or
#   ASC_KEY_P8_BASE64  the file's contents, base64-encoded (better for CI
#                      secret stores, which handle single-line values best)
def load_asc_api_key
  require_env!("ASC_KEY_ID", "ASC_ISSUER_ID")

  key_path = ENV["ASC_KEY_P8_PATH"].to_s.strip
  key_b64  = ENV["ASC_KEY_P8_BASE64"].to_s.strip

  if key_path.empty? && key_b64.empty?
    UI.user_error!(<<~MSG)
      No App Store Connect private key supplied.

      Set exactly one of:
        ASC_KEY_P8_PATH    /absolute/path/to/AuthKey_<ASC_KEY_ID>.p8
        ASC_KEY_P8_BASE64  base64 of that same file

      Create the key at App Store Connect -> Users and Access -> Integrations
      -> App Store Connect API. Apple lets you download the .p8 exactly once.
    MSG
  end

  if !key_path.empty? && !File.exist?(key_path)
    UI.user_error!("ASC_KEY_P8_PATH points at #{key_path}, which does not exist.")
  end

  params = {
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    # Individual/company keys are not "in house"; set ASC_KEY_IN_HOUSE=true only
    # for an Apple Developer Enterprise Program key.
    in_house: ENV["ASC_KEY_IN_HOUSE"] == "true",
    duration: 1200
  }

  if key_path.empty?
    params[:key_content] = key_b64
    params[:is_key_content_base64] = true
  else
    params[:key_filepath] = key_path
  end

  app_store_connect_api_key(**params)
end

# Reads back what match just installed. match exports one variable per
# identifier; if a profile is missing the export step would fail with a much
# vaguer message, so we check here and name the target.
def provisioning_profile_mapping(type)
  APP_IDENTIFIERS.each_with_object({}) do |identifier, mapping|
    name = ENV["sigh_#{identifier}_#{type}_profile-name"]

    if name.to_s.strip.empty?
      UI.user_error!(<<~MSG)
        match did not produce a '#{type}' profile for #{identifier}.

        Every one of the four targets needs its own profile. Run the bootstrap
        once on a machine with Developer Portal access:

            MATCH_READONLY=false fastlane match_bootstrap

        If that fails for this identifier specifically, the App ID probably
        does not exist in the Developer Portal yet, or it is missing a
        capability the entitlements file asks for (App Groups on all four;
        Family Controls on the host app and UnplugMonitor).
      MSG
    end

    mapping[identifier] = name
  end
end

def resolved_team_id
  team = ENV["FASTLANE_TEAM_ID"].to_s.strip
  return team unless team.empty?

  UI.user_error!(<<~MSG)
    FASTLANE_TEAM_ID is not set.

    It is the 10-character Developer Portal team id (e.g. ABCDE12345), visible
    at developer.apple.com -> Membership. The export step needs it explicitly
    because no DEVELOPMENT_TEAM is baked into the Xcode project.
  MSG
end

# Build the -exportOptionsPlist that `flutter build ipa` hands to xcodebuild.
# Written to a temp path, never into the repo.
def write_export_options_plist(type: "appstore", method: nil)
  mapping = provisioning_profile_mapping(type)
  export_method = method || ENV["TETHER_EXPORT_METHOD"] || "app-store"

  entries = mapping.map do |identifier, profile_name|
    "\t\t<key>#{identifier}</key>\n\t\t<string>#{profile_name}</string>"
  end.join("\n")

  plist = <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>method</key>
    \t<string>#{export_method}</string>
    \t<key>teamID</key>
    \t<string>#{resolved_team_id}</string>
    \t<key>signingStyle</key>
    \t<string>manual</string>
    \t<key>signingCertificate</key>
    \t<string>Apple Distribution</string>
    \t<key>stripSwiftSymbols</key>
    \t<true/>
    \t<key>uploadSymbols</key>
    \t<true/>
    \t<key>destination</key>
    \t<string>export</string>
    \t<key>provisioningProfiles</key>
    \t<dict>
    #{entries}
    \t</dict>
    </dict>
    </plist>
  PLIST

  dir = File.join(Dir.tmpdir, "tether-health-export-options")
  FileUtils.mkdir_p(dir)
  path = File.join(dir, "ExportOptions-#{type}.plist")
  File.write(path, plist)

  UI.message("Export options written to #{path}")
  mapping.each { |id, name| UI.message("  #{id} -> #{name}") }

  path
end

def newest_ipa
  pattern = File.join(FLUTTER_PROJECT_DIR, "build", "ios", "ipa", "*.ipa")
  ipa = Dir.glob(pattern).max_by { |f| File.mtime(f) }

  if ipa.nil?
    UI.user_error!(<<~MSG)
      No .ipa found at #{pattern}

      `flutter build ipa` reported success but produced nothing. Check the
      xcodebuild export log it printed — an export failure caused by a missing
      extension profile is reported there, not by the flutter tool.
    MSG
  end

  UI.success("Built #{ipa} (#{(File.size(ipa) / 1_048_576.0).round(1)} MB)")
  ipa
end

# ---------------------------------------------------------------------------
# Lanes
# ---------------------------------------------------------------------------

platform :ios do
  desc "Check the machine and the Xcode project can produce a distributable build"
  lane :preflight do
    flutter_bin

    UI.message("Checking Xcode project signing configuration...")
    pbxproj = File.exist?(PBXPROJ_PATH) ? File.read(PBXPROJ_PATH) : ""
    problems = []

    unless pbxproj.include?("DEVELOPMENT_TEAM")
      problems << <<~ITEM
        No DEVELOPMENT_TEAM is set on any target in
        ios/Runner.xcodeproj/project.pbxproj. The archive step cannot pick a
        signing identity without it.
      ITEM
    end

    if pbxproj.include?("CODE_SIGNING_ALLOWED = NO")
      problems << <<~ITEM
        CODE_SIGNING_ALLOWED = NO is still present in the project. It is set on
        all three extension targets (#{EXTENSION_TARGETS.join(', ')}) in every
        build configuration. An app extension that is not code-signed cannot be
        embedded in a distributable archive; the upload is rejected.
      ITEM
    end

    if problems.empty?
      UI.success("Xcode project looks signable.")
    else
      UI.important("=" * 72)
      problems.each_with_index { |p, i| UI.important("#{i + 1}. #{p.strip}") }
      UI.important("=" * 72)
      UI.user_error!(
        "The Xcode project is not ready for distribution. See the " \
        '"Xcode project prerequisites" section of docs/releasing.md. ' \
        "Set TETHER_SKIP_PREFLIGHT=true to bypass this check once the project " \
        "is configured in a way this heuristic does not recognise."
      )
    end
  end

  desc "One-time: create/fetch distribution certs and profiles for all four targets"
  lane :match_bootstrap do
    load_asc_api_key

    # Explicitly not readonly — this is the run that is allowed to create.
    match(type: "appstore", app_identifier: APP_IDENTIFIERS, readonly: false)

    UI.success("App Store profiles present for all #{APP_IDENTIFIERS.count} targets:")
    provisioning_profile_mapping("appstore").each { |id, name| UI.success("  #{id} -> #{name}") }
  end

  desc "Fetch development certs and profiles for all four targets"
  lane :match_development do
    load_asc_api_key
    match(type: "development", app_identifier: APP_IDENTIFIERS, readonly: false)
  end

  desc "Print the export options plist that would be handed to xcodebuild"
  lane :print_export_options do
    # Debugging aid. Reads whatever match last exported into the environment,
    # so run it after `match_bootstrap` in the same shell. It builds no code
    # and talks to no Apple service.
    path = write_export_options_plist(type: "appstore")
    UI.message("\n" + File.read(path))
  end

  desc "Build a signed App Store IPA (no upload)"
  lane :build do
    build_signed_ipa
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    ipa = build_signed_ipa

    upload_to_testflight(
      ipa: ipa,
      app_identifier: HOST_APP_IDENTIFIER,
      # Processing can take 20+ minutes for an app with three extensions.
      # Waiting is the default; set TETHER_TF_WAIT=false in CI to fire and forget.
      skip_waiting_for_build_processing: ENV["TETHER_TF_WAIT"] == "false",
      # Do not auto-distribute. Externally testing a Family Controls app needs
      # a review pass, so let a human choose the group.
      distribute_external: false,
      changelog: ENV["TETHER_CHANGELOG"] || "Internal build from #{`git rev-parse --short HEAD 2>/dev/null`.strip}"
    )

    UI.success("Uploaded to TestFlight.")
  end

  desc "Build and upload to App Store Connect for review"
  lane :release do
    ipa = build_signed_ipa

    upload_to_app_store(
      ipa: ipa,
      app_identifier: HOST_APP_IDENTIFIER,
      # Metadata and screenshots are managed in App Store Connect, not in this
      # repo. Uploading binary-only keeps a release lane from silently
      # overwriting copy that went through clinical/legal review.
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: false,
      # Submission is opt-in: set TETHER_SUBMIT_FOR_REVIEW=true to actually put
      # it in front of App Review.
      submit_for_review: ENV["TETHER_SUBMIT_FOR_REVIEW"] == "true",
      automatic_release: false,
      force: true, # no interactive HTML preview confirmation
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )

    if ENV["TETHER_SUBMIT_FOR_REVIEW"] == "true"
      UI.success("Uploaded and submitted for review.")
    else
      UI.success("Uploaded to App Store Connect. Submit for review from the web UI, " \
                 "or re-run with TETHER_SUBMIT_FOR_REVIEW=true.")
    end
  end

  error do |lane, exception|
    UI.error("Lane '#{lane}' failed: #{exception.message}")
    UI.error("Troubleshooting: docs/releasing.md")
  end
end

# ---------------------------------------------------------------------------
# Build helpers
#
# Plain methods rather than private_lanes on purpose: a lane is invoked with an
# options hash, which makes passing a single path around needlessly awkward.
# Inside a Fastfile these still reach every action through FastFile's
# method_missing, so `match`, `build_app` and `sh` all work as usual.
# ---------------------------------------------------------------------------

def build_signed_ipa
  preflight unless ENV["TETHER_SKIP_PREFLIGHT"] == "true"

  load_asc_api_key

  # Pulls the distribution cert and ALL FOUR profiles into the keychain.
  # readonly comes from the Matchfile (MATCH_READONLY=true on CI).
  match(type: "appstore", app_identifier: APP_IDENTIFIERS)

  export_options = write_export_options_plist(type: "appstore")

  if ENV["TETHER_IOS_BUILDER"] == "gym"
    build_with_gym(export_options)
  else
    build_with_flutter(export_options)
  end
end

def flutter_version_args
  args = []
  args << "--build-name=#{ENV['TETHER_BUILD_NAME']}" unless ENV["TETHER_BUILD_NAME"].to_s.empty?
  args << "--build-number=#{ENV['TETHER_BUILD_NUMBER']}" unless ENV["TETHER_BUILD_NUMBER"].to_s.empty?
  args
end

# Default path. `flutter build ipa` runs pub get, the build_runner/pigeon
# steps, assembles the Flutter assets, archives with xcodebuild and exports
# using our plist. None of that is reimplemented here.
def build_with_flutter(export_options_path)
  args = ["build", "ipa", "--release"]
  args.concat(flutter_version_args)
  args << "--export-options-plist=#{Shellwords.escape(export_options_path)}"

  flutter!(args.join(" "))
  newest_ipa
end

# Opt-in path (TETHER_IOS_BUILDER=gym). Flutter still does the Flutter part —
# `--no-codesign` stops it trying to sign — then gym owns archive and export.
# Useful when you need a gym-only knob such as custom xcargs or a different
# export method.
def build_with_gym(export_options_path)
  args = ["build", "ios", "--release", "--no-codesign"]
  args.concat(flutter_version_args)
  flutter!(args.join(" "))

  output_dir = File.join(FLUTTER_PROJECT_DIR, "build", "ios", "ipa")
  FileUtils.mkdir_p(output_dir)

  build_app(
    workspace: "Runner.xcworkspace",
    scheme: "Runner", # the only shared scheme in the project
    configuration: "Release",
    export_method: ENV["TETHER_EXPORT_METHOD"] || "app-store",
    export_options: export_options_path,
    output_directory: output_dir,
    output_name: "tether_health.ipa",
    clean: false,
    include_bitcode: false,
    include_symbols: true,
    # Manual signing for four targets is expressed through the export options
    # plist; xcargs only supplies what the project itself is missing.
    xcargs: "DEVELOPMENT_TEAM=#{resolved_team_id} CODE_SIGN_STYLE=Manual"
  )

  newest_ipa
end
