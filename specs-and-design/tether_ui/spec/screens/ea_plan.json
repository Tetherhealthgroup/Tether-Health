  "notes": [],
  "over": null,
  "api": [],
  "actions": [
    {
      "element": "Back",
      "path": "header.left",
      "action": {
        "type": "back"
      },
      "summary": "back"
    },
    {
      "element": "Save plan",
      "path": "footer[0]",
      "action": {
        "type": "submit",
        "api": "PUT device:encrypted/ea/safety-plan",
        "then": {
          "type": "replace",
          "to": "ea_home",
          "context": {
            "onboarding": "ob_setup"
          }
        }
      },
      "summary": "PUT device:encrypted/ea/safety-plan then replace → ea_home (onboarding: ob_setup)"
    }
  ]
