{
  "id": "ea_plan",
  "name": "Safety plan",
  "route": "/p/ea/plan",
  "flow": "ea",
  "program": "ea",
  "phase": "plan",
  "kind": "screen",
  "tab": null,
  "variantOf": null,
  "state": "default",
  "dark": false,
  "bg": null,
  "desc": "Stored encrypted on the device only.",
  "header": {
    "t": "header",
    "title": "Safety plan",
    "left": "back",
    "pill": "Private"
  },
  "body": [
    {
      "t": "title",
      "text": "Make a plan for hard moments",
      "size": "m"
    },
    {
      "t": "text",
