      "tone": "small"
    },
    {
      "t": "field",
      "label": "My warning signs",
      "placeholder": "Not sleeping, pulling away from friends",
      "kind": "multiline",
      "key": "my_warning_signs"
    },
    {
      "t": "field",
      "label": "Things that help me",
      "placeholder": "Walk the dog, shower, music",
      "kind": "text",
      "key": "things_that_help_me"
    },
    {
      "t": "field",
      "label": "People I can reach",
      "placeholder": "Sam · (555) 010-3311",
      "kind": "text",
      "key": "people_i_can_reach"
    },
    {
      "t": "kv",
      "rows": [
        [
          "Crisis line",
          "988 · call or text"
        ],
        [
          "Emergency",
          "911"
        ]
      ]
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Save plan",
      "action": {
        "type": "submit",
        "api": "PUT device:encrypted/ea/safety-plan",
        "then": {
          "type": "replace",
          "to": "ea_home",
          "context": {
            "onboarding": "ob_setup"
          }
        }
      },
      "variant": "primary",
      "arrow": true
