{
  "id": "account_notifications",
  "name": "Notifications",
  "route": "/account/notifications",
  "flow": "account",
  "program": null,
  "phase": "account",
  "kind": "screen",
  "tab": null,
  "variantOf": null,
  "state": "default",
  "dark": false,
  "bg": null,
  "desc": "",
  "header": {
    "t": "header",
    "title": "Notifications",
    "left": "back"
  },
  "body": [
    {
      "t": "card",
      "variant": "plain",
      "children": [
        {
          "t": "toggle",
          "label": "Check-ins and plan reminders",
          "sub": "At most 2 a day",
          "on": true,
          "key": "check_ins_and_plan_reminders",
          "bind": "notifications.check_ins_and_plan_reminders"
        },
        {
          "t": "toggle",
          "label": "Show sensitive details",
          "sub": "Off: program names and health data hidden",
          "on": false,
          "key": "show_sensitive_details",
          "bind": "notifications.show_sensitive_details"
        },
        {
          "t": "toggle",
          "label": "Quiet hours",
          "sub": "9:00 PM – 7:00 AM · safety alerts still come through",
          "on": true,
          "key": "quiet_hours",
          "bind": "notifications.quiet_hours"
        }
      ]
    },
    {
      "t": "list",
      "title": "Per program",
      "rows": [
        {
          "label": "BreatheFree",
          "sub": "8:00 AM check-in",
          "action": {
            "type": "toast",
            "value": "Reminder time saved"
          },
          "lead": {
            "program": "bf"
          }
        },
        {
          "label": "ScrollFree",
          "sub": "9:30 PM wind-down",
          "action": {
            "type": "toast",
            "value": "Reminder time saved"
          },
          "lead": {
            "program": "sf"
          }
        }
      ],
      "data": {
        "rows[0].sub": "notifications.bf.summary",
        "rows[1].sub": "notifications.sf.summary"
      }
    },
    {
      "t": "card",
      "variant": "plain",
      "eyebrow": "Lock screen preview",
      "title": "Tether Health",
      "text": "You have a Tether reminder."
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Save",
      "action": {
        "type": "submit",
        "api": "PATCH /v1/notifications/preferences",
        "then": {
          "type": "toast",
          "value": "Saved",
          "then": {
            "type": "back"
          }
        }
      },
      "variant": "primary",
      "arrow": true
    }
  ],
  "notes": [],
  "over": null,
  "api": [],
  "actions": [
    {
      "element": "Back",
      "path": "header.left",
      "action": {
        "type": "back"
      },
      "summary": "back"
    },
    {
      "element": "BreatheFree",
      "path": "body[1].rows[0]",
      "action": {
        "type": "toast",
        "value": "Reminder time saved"
      },
      "summary": "toast “Reminder time saved”"
    },
    {
      "element": "ScrollFree",
      "path": "body[1].rows[1]",
      "action": {
        "type": "toast",
        "value": "Reminder time saved"
      },
      "summary": "toast “Reminder time saved”"
    },
    {
      "element": "Save",
      "path": "footer[0]",
      "action": {
        "type": "submit",
        "api": "PATCH /v1/notifications/preferences",
        "then": {
          "type": "toast",
          "value": "Saved",
          "then": {
            "type": "back"
          }
        }
      },
      "summary": "PATCH /v1/notifications/preferences then toast “Saved” then back"
    }
  ]
}
