{
  "id": "records_review",
  "name": "Review imported data",
  "route": "/records/review",
  "flow": "records",
  "program": null,
  "phase": "resources",
  "kind": "screen",
  "tab": null,
  "variantOf": null,
  "state": "default",
  "dark": false,
  "bg": null,
  "desc": "Validation pipeline: FHIR R4 schema → code mapping (LOINC, SNOMED CT, CVX, RxNorm) → unit normalisation (UCUM) → plausibility ranges → duplicate detection (code + date + value) → conflict with manual entries → member review.",
  "header": {
    "t": "header",
    "title": "Review",
    "left": "close",
    "pill": "Not added yet"
  },
  "body": [
    {
      "t": "title",
      "text": "Review before adding",
      "size": "m"
    },
    {
      "t": "text",
      "text": "Nothing reaches your programs until you confirm.",
      "tone": "muted"
    },
    {
      "t": "banner",
      "kind": "offline",
      "text": "2 items need your review.",
      "action": {
        "type": "push",
        "to": "records_conflict"
      },
      "actionLabel": "Review",
      "data": {
        "text": "records.review_banner"
      }
    },
    {
      "t": "card",
      "variant": "plain",
      "tag": "hw",
      "children": [
        {
          "t": "checklist",
          "items": [
            {
              "label": "12 blood pressure readings",
              "sub": "Jun – Oct 2026"
            },
            {
              "label": "Lipid panel",
              "sub": "LDL 138 · Sep 30"
            }
          ],
          "key": "keep_hw"
        }
      ]
    },
    {
      "t": "card",
      "variant": "plain",
      "tag": "st",
      "children": [
        {
          "t": "checklist",
          "items": [
            {
              "label": "A1C 7.6%",
              "sub": "Oct 1 · differs from your entry (7.4%)"
            }
          ],
          "key": "keep_st"
        }
      ]
    },
    {
      "t": "card",
      "variant": "plain",
      "tag": "ck",
      "children": [
        {
          "t": "checklist",
          "items": [
            {
              "label": "Flu vaccine",
              "sub": "Oct 12, 2025"
            },
            {
              "label": "Tdap",
              "sub": "2019"
            }
          ],
          "key": "keep_ck"
        }
      ]
    },
    {
      "t": "card",
      "variant": "plain",
      "tag": "bf",
      "children": [
        {
          "t": "checklist",
          "items": [
            {
              "label": "Smoking status: every day smoker",
              "sub": "Aug 2026 · sets your baseline"
            }
          ],
          "key": "keep_bf"
        }
      ]
    },
    {
      "t": "card",
      "variant": "plain",
      "tag": "re",
      "children": [
        {
          "t": "checklist",
          "items": [
            {
              "label": "eGFR 58",
              "sub": "Oct 3"
            }
          ],
          "key": "keep_re"
        }
      ]
    },
    {
      "t": "eyebrow",
      "text": "Checked automatically"
    },
    {
      "t": "kv",
      "rows": [
        [
          "Units converted",
          "2 glucose results · mmol/L → mg/dL"
        ],
        [
          "Duplicates skipped",
          "3 readings you already entered"
        ],
        [
          "Held as likely typo",
          "1 · BP 1290/80"
        ],
        [
          "Future dates rejected",
          "0"
        ]
      ],
      "data": {
        "rows[0][1]": "records.review.units_converted",
        "rows[1][1]": "records.review.duplicates_skipped",
        "rows[2][1]": "records.review.held_as_typo",
        "rows[3][1]": "records.review.future_dates_rejected"
      }
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Add selected items to my programs",
      "action": {
        "type": "branch",
        "question": "Anything selected?",
        "on": null,
        "decide": "rec.review",
        "cases": [
          {
            "label": "Chosen",
            "action": {
              "type": "submit",
              "api": "POST /v1/records/fhir/accept",
              "then": {
                "type": "toast",
                "value": "Added to your programs",
                "then": {
                  "type": "popto",
                  "to": "records_hub"
                }
              }
            }
          },
          {
            "label": "Nothing chosen",
            "action": {
              "type": "toast",
              "value": "Select the items you want to add."
            }
          }
        ]
      },
      "variant": "primary",
      "arrow": true
    },
    {
      "t": "link",
      "label": "Review conflicts first",
      "action": {
        "type": "push",
        "to": "records_conflict"
      },
      "align": "center"
    }
  ],
  "notes": [],
  "over": null,
  "api": [],
  "actions": [
    {
      "element": "Close",
      "path": "header.left",
      "action": {
        "type": "close"
      },
      "summary": "close"
    },
    {
      "element": "Review",
      "path": "body[2]",
      "action": {
        "type": "push",
        "to": "records_conflict"
      },
      "summary": "push → records_conflict"
    },
    {
      "element": "Add selected items to my programs",
      "path": "footer[0]",
      "action": {
        "type": "branch",
        "question": "Anything selected?",
        "on": null,
        "decide": "rec.review",
        "cases": [
          {
            "label": "Chosen",
            "action": {
              "type": "submit",
              "api": "POST /v1/records/fhir/accept",
              "then": {
                "type": "toast",
                "value": "Added to your programs",
                "then": {
                  "type": "popto",
                  "to": "records_hub"
                }
              }
            }
          },
          {
            "label": "Nothing chosen",
            "action": {
              "type": "toast",
              "value": "Select the items you want to add."
            }
          }
        ]
      },
      "summary": "decide rec.review: Anything selected? → Chosen: POST /v1/records/fhir/accept then toast “Added to your programs” then popto → records_hub | Nothing chosen: toast “Select the items you want to add.”"
    },
    {
      "element": "Review conflicts first",
      "path": "footer[1]",
      "action": {
        "type": "push",
        "to": "records_conflict"
      },
      "summary": "push → records_conflict"
    }
  ]
}
