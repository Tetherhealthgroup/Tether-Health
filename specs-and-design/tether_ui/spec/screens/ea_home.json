    {
      "element": "Tab · Learn",
      "path": "tabbar.learn",
      "action": {
        "type": "tab",
        "to": "learn"
      },
      "summary": "tab → learn"
    },
    {
      "element": "Tab · Support",
      "path": "tabbar.support",
      "action": {
        "type": "tab",
        "to": "support"
      },
      "summary": "tab → support"
    }
  ]
