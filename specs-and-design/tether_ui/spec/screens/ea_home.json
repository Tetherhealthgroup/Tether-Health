    }
  },
  "body": [
    {
      "t": "card",
      "variant": "dark",
      "eyebrow": "How are you right now?",
      "title": "30-second mood check-in",
      "cta": {
        "t": "button",
        "label": "Start",
        "action": {
          "type": "push",
          "to": "ea_mood"
        },
        "variant": "lime",
        "arrow": false,
        "small": true
      }
    },
    {
      "t": "list",
      "rows": [
        {
          "label": "My safety plan",
          "sub": "Updated Oct 2",
          "action": {
            "type": "push",
            "to": "ea_plan"
          }
        },
        {
          "label": "Check-back",
          "sub": "In 6 days",
          "action": {
            "type": "push",
            "to": "ea_checkback"
          }
        },
        {
          "label": "Find a professional",
          "action": {
            "type": "push",
            "to": "ea_result"
          }
        },
        {
          "label": "Program settings",
          "sub": "Status, sharing, export, leave",
          "action": {
            "type": "push",
            "to": "program_settings"
          }
        }
      ],
      "data": {
        "rows[0].sub": "ea.plan_updated",
        "rows[1].sub": "ea.check_back_due"
      }
    },
    {
      "t": "card",
      "variant": "plain",
      "tag": "ea",
      "title": "Sleep and mood: 3 small changes",
      "text": "5 min",
      "action": {
        "type": "push",
        "to": "learn_lesson",
        "arg": "ea.sleep-and-mood"
      }
    },
    {
      "t": "emergency",
      "text": "Thoughts of harming yourself? Call or text 988. Emergency: 911.",
      "actions": [
        {
          "t": "button",
          "label": "Call or text 988",
          "action": {
            "type": "push",
            "to": "crisis"
          },
          "variant": "danger",
          "arrow": false,
          "small": true
        },
        {
          "t": "button",
          "label": "Call 911",
          "action": {
            "type": "call",
            "value": "911",
            "label": "911"
          },
          "variant": "secondary",
          "arrow": false,
          "small": true
        }
      ]
    }
  ],
  "footer": [],
  "notes": [],
  "over": null,
  "api": [],
