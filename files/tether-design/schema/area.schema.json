{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tether/area.schema.json",
  "title": "Health area catalogue",
  "type": "object",
  "required": ["version", "areas"],
  "properties": {
    "version": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "areas": { "type": "array", "items": { "$ref": "#/$defs/area" } }
  },
  "$defs": {
    "area": {
      "type": "object",
      "required": ["id", "name", "scope", "status", "serviceLines", "safeguards"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z_]+$" },
        "name": { "type": "string" },
        "scope": { "type": "string", "description": "The conditions this area covers, as published." },
        "status": { "enum": ["in_development", "planned", "live"] },
        "url": { "type": "string", "format": "uri" },
        "productId": { "type": ["string", "null"] },
        "serviceLines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/serviceLine" } },
        "measures": { "type": "array", "items": { "$ref": "#/$defs/measure" } },
        "safeguards": { "type": "array", "minItems": 1, "items": { "type": "string" },
          "description": "Safeguard ids. Every area must declare at least one." },
        "reuses": { "type": "array", "items": { "type": "string" },
          "description": "Service lines in other areas this one builds on rather than duplicating." },
        "accessibilityFloor": {
          "type": "object",
          "properties": {
            "minTextScale": { "type": "number" },
            "minTapTarget": { "type": "number" },
            "minContrast": { "type": "number" }
          }
        }
      }
    },
    "serviceLine": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "proposed": { "type": "boolean", "description": "Not yet published on the site." }
      }
    },
    "measure": {
      "type": "object",
      "required": ["id", "label", "unit"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "unit": { "enum": ["count", "duration", "currency", "date", "text", "scale_0_10", "mg_dl", "mmhg_pair", "instrument"] },
        "selfReported": { "type": "boolean" },
        "derived": { "type": "boolean" },
        "estimate": { "type": "boolean" },
        "clinicalThresholds": { "type": "boolean", "description": "Values can be dangerous. Requires out_of_range_routing." },
        "neverDiagnostic": { "type": "boolean" },
        "platformDependent": { "type": "boolean", "description": "Availability differs by OS. Design to the lower floor." }
      }
    }
  }
}
