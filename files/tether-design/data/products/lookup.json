  },
  "proposedArchetypes": [
    {
      "id": "age_gate",
      "reason": "Under-18 populations need a tier ceiling and guardian link. Reusable by aging (supporter involvement) and preventive (age-appropriate screening)."
    },
    {
      "id": "intercept",
      "reason": "Interrupts the behaviour at the moment it starts. Only possible where the trigger lives inside the device — currently unique to this area."
    },
    {
      "id": "environment",
      "reason": "Reduces cue exposure rather than resisting it. Generalises to nutrition (kitchen setup) and tobacco (removing smoking cues)."
    }
  ]
