{
  "version": "1.1.0",
  "$comment": "The shared behaviour-change machinery. Improve an archetype once and every area inherits it. A product screen must reference an archetype id and fill its slots.",
  "archetypes": [
    {
      "id": "welcome",
      "name": "Welcome",
      "purpose": "A private, judgment-free opening that asks for nothing before it gives something.",
      "chrome": {
        "leading": "none",
        "badge": false
      },
      "slots": {
        "headline": "required",
        "sub": "required",
        "promiseCards": "required:3",
        "localePicker": "optional"
      },
      "actions": [
        {
          "kind": "primary",
          "to": "why"
        },
        {
          "kind": "ghost",
          "to": "sso"
        }
      ],
      "requires": [
        "product_disclaimer"
      ]
    },
    {
      "id": "why",
      "name": "What it does",
      "purpose": "Four capabilities, each named for the moment it is needed.",
      "chrome": {
        "leading": "close",
        "badge": true
      },
      "slots": {
        "headline": "required",
        "sub": "optional",
        "capabilityCards": "required:4"
      },
      "actions": [
        {
          "kind": "primary",
          "to": "consent"
        }
      ]
    },
    {
      "id": "consent",
