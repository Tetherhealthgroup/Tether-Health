#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Simulator builds are arm64-only. See the note in Debug.xcconfig — the same
// lipo incompatibility breaks `flutter build ios --simulator --release`.
// Device and archive builds are unaffected: they are arm64-only already.
ARCHS = arm64
EXCLUDED_ARCHS = i386 x86_64
