    {
      "t": "title",
      "text": "Add a health value",
      "size": "m"
    },
    {
      "t": "chips",
      "options": [
        "Blood pressure",
        "Glucose",
        "Lab result",
        "Vaccine",
        "Medication",
        "Condition"
      ],
      "selected": [
        "Lab result"
      ],
      "multi": false,
      "label": "Type",
      "key": "type"
    },
    {
      "t": "field",
      "label": "Test",
      "value": "A1C",
      "kind": "select",
      "key": "test"
    },
    {
      "t": "field",
      "label": "Value",
      "value": "7.4",
      "unit": "%",
      "kind": "number",
      "key": "value"
    },
    {
      "t": "field",
      "label": "Date",
      "value": "Oct 1, 2026",
      "kind": "date",
      "key": "date"
    },
    {
      "t": "text",
      "text": "Checked against plausible ranges and your connected records. Manual values are labelled “Entered by you”.",
      "tone": "small"
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Save",
      "action": {
        "type": "submit",
        "api": "POST /v1/records/manual",
        "then": {
          "type": "branch",
          "question": "Validation",
          "on": null,
          "decide": "rec.manual",
          "cases": [
            {
              "label": "Valid",
              "action": {
                "type": "toast",
                "value": "Saved · shared with Steady",
                "then": {
                  "type": "popto",
                  "to": "records_hub"
                }
              }
            },
            {
              "label": "Outside expected range",
              "action": {
                "type": "replace",
                "to": "records_manual_error"
              }
            },
            {
              "label": "Matches an imported value",
              "action": {
                "type": "toast",
                "value": "Already in your records from Epic. Not added twice.",
                "then": {
                  "type": "back"
                }
              }
            }
          ]
        }
      },
      "variant": "primary",
      "arrow": true
    }
  ],
