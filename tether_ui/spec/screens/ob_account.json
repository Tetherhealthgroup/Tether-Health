{
  "id": "ob_account",
  "name": "Save your progress",
  "route": "/onboarding/account",
  "flow": "onboarding",
  "program": null,
  "phase": "account",
  "kind": "screen",
  "tab": null,
  "variantOf": null,
  "state": "default",
  "dark": false,
  "bg": null,
  "desc": "",
  "header": {
    "t": "header",
    "title": "Save your progress",
    "left": "close"
  },
  "body": [
    {
      "t": "title",
      "text": "Create your account",
      "size": "m"
    },
    {
      "t": "text",
      "text": "Keeps your plans safe if you change phones. You can also continue on this phone only.",
      "tone": "muted"
    },
    {
      "t": "authbuttons",
      "items": [
        {
          "t": "authbtn",
          "provider": "apple",
          "label": "Continue with Apple",
          "action": {
            "type": "branch",
            "question": "“I’m 18 or older” ticked?",
            "on": null,
            "decide": "ob.age",
            "cases": [
              {
                "label": "Age confirmed",
                "action": {
                  "type": "branch",
                  "question": "Sign in with Apple result",
                  "provider": "apple",
                  "on": null,
                  "decide": null,
                  "cases": [
                    {
                      "label": "Success",
                      "action": {
                        "type": "push",
                        "to": "auth_merge"
                      }
                    },
                    {
                      "label": "Email already has a Tether account",
                      "action": {
                        "type": "push",
                        "to": "auth_link"
                      }
                    },
                    {
                      "label": "Cancelled",
                      "action": {
                        "type": "toast",
                        "value": "Sign-in cancelled"
                      }
                    },
                    {
                      "label": "Error",
                      "action": {
                        "type": "push",
                        "to": "auth_social_error"
                      }
                    }
                  ]
                }
              },
              {
                "label": "Age not confirmed",
                "action": {
                  "type": "toast",
                  "value": "You need to be 18 or older to continue."
                }
              }
            ]
          },
          "platforms": [
            "ios"
          ]
        },
        {
          "t": "authbtn",
          "provider": "google",
          "label": "Continue with Google",
          "action": {
            "type": "branch",
            "question": "“I’m 18 or older” ticked?",
            "on": null,
            "decide": "ob.age",
            "cases": [
              {
                "label": "Age confirmed",
                "action": {
                  "type": "branch",
                  "question": "Sign in with Google result",
                  "provider": "google",
                  "on": null,
                  "decide": null,
                  "cases": [
                    {
                      "label": "Success",
                      "action": {
                        "type": "push",
                        "to": "auth_merge"
                      }
                    },
                    {
                      "label": "Email already has a Tether account",
                      "action": {
                        "type": "push",
                        "to": "auth_link"
                      }
                    },
                    {
                      "label": "Cancelled",
                      "action": {
                        "type": "toast",
                        "value": "Sign-in cancelled"
                      }
                    },
                    {
                      "label": "Error",
                      "action": {
                        "type": "push",
                        "to": "auth_social_error"
                      }
                    }
                  ]
                }
              },
              {
                "label": "Age not confirmed",
                "action": {
                  "type": "toast",
                  "value": "You need to be 18 or older to continue."
                }
              }
            ]
          },
          "platforms": [
            "ios",
            "android"
          ]
        }
      ]
    },
    {
      "t": "text",
      "text": "Sign in with Apple can hide your email: we use Apple’s private relay address.",
      "tone": "small"
    },
    {
      "t": "eyebrow",
      "text": "Or with email"
    },
    {
      "t": "field",
      "label": "Email",
      "placeholder": "alex@example.com",
      "kind": "email",
      "key": "email"
    },
    {
      "t": "field",
      "label": "Password",
      "hint": "At least 12 characters. A passphrase works well.",
      "placeholder": "••••••••••••",
      "kind": "password",
      "key": "password"
    },
    {
      "t": "checklist",
      "items": [
        {
          "label": "I’m 18 or older"
        }
      ],
      "key": "age_18_or_older"
    },
    {
      "t": "text",
      "text": "Guest plans are encrypted on this phone. If you sign up later, we ask before uploading them.",
      "tone": "small"
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Create account",
      "action": {
        "type": "branch",
        "question": "“I’m 18 or older” ticked?",
        "on": null,
        "decide": "ob.age",
        "cases": [
          {
            "label": "Age confirmed",
            "action": {
              "type": "submit",
              "api": "POST supabase /auth/v1/signup",
              "then": {
                "type": "push",
                "to": "auth_verify"
              }
            }
          },
          {
            "label": "Age not confirmed",
            "action": {
              "type": "toast",
              "value": "You need to be 18 or older to continue."
            }
          }
        ]
      },
      "variant": "primary",
      "arrow": true
    },
    {
