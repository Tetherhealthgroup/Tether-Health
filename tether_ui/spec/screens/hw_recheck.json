{
  "id": "hw_recheck",
  "name": "Re-check timer",
  "route": "/p/hw/crisis/recheck",
  "flow": "hw",
  "program": "hw",
  "phase": "rescue",
  "kind": "screen",
  "tab": null,
  "variantOf": null,
  "state": "default",
  "dark": false,
  "bg": null,
  "desc": "",
  "header": {
    "t": "header",
    "title": "Re-check",
    "left": "close"
  },
  "body": [
    {
      "t": "title",
      "text": "Rest, then measure again.",
      "size": "m",
      "align": "center"
    },
    {
      "t": "timer",
      "value": "4:12",
      "label": "until re-check"
    },
    {
      "t": "card",
      "variant": "plain",
      "children": [
        {
          "t": "checklist",
          "items": [
            {
              "label": "Sit with your back supported"
            },
            {
              "label": "Feet flat, arm at heart level"
            },
            {
              "label": "No talking while measuring"
            }
          ]
        }
      ]
    },
    {
      "t": "emergency",
      "text": "New chest pain, weakness or trouble speaking? Call 911 now.",
      "actions": [
        {
          "t": "button",
          "label": "Call 911",
          "action": {
            "type": "call",
            "value": "911",
            "label": "911"
          },
          "variant": "danger",
          "arrow": false,
          "small": true
        }
      ]
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Re-check now",
      "action": {
        "type": "replace",
        "to": "hw_log"
      },
      "variant": "primary",
      "arrow": true
    },
    {
      "t": "button",
      "label": "Contact my clinician",
      "action": {
        "type": "push",
        "to": "support_message_care"
      },
      "variant": "secondary",
      "arrow": false
    }
  ],
  "notes": [],
  "over": null,
  "api": [],
  "actions": [
    {
      "element": "Close",
      "path": "header.left",
      "action": {
        "type": "close"
      },
      "summary": "close"
    },
    {
      "element": "Call 911",
      "path": "body[3].actions[0]",
      "action": {
        "type": "call",
        "value": "911",
        "label": "911"
      },
      "summary": "call 911"
    },
    {
      "element": "Re-check now",
      "path": "footer[0]",
      "action": {
        "type": "replace",
        "to": "hw_log"
      },
      "summary": "replace → hw_log"
    },
    {
      "element": "Contact my clinician",
      "path": "footer[1]",
      "action": {
        "type": "push",
        "to": "support_message_care"
      },
      "summary": "push → support_message_care"
    }
  ]
}
