            }
          },
          {
            "label": "Cancelled",
            "action": {
              "type": "toast",
              "value": "Cancelled"
            }
          },
          {
            "label": "Error",
            "action": {
              "type": "push",
              "to": "auth_social_error"
            }
          }
        ]
      },
      "summary": "auth (google): Sign in with Google result → Success: toast “Google connected” | Email already has a Tether account: push → auth_link | Cancelled: toast “Cancelled” | Error: push → auth_social_error"
