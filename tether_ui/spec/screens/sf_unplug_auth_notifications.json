    },
    {
      "t": "title",
      "text": "Turn on notifications for Unplug?",
      "size": "m"
    },
    {
      "t": "text",
      "text": "When a pause screen sends you to Tether, including Get support, it uses a notification. With notifications off, Unplug still pauses apps, and the pause screen tells you to open Tether yourself for support.",
      "tone": "muted"
    }
  ],
  "footer": [
