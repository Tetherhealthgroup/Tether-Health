  "bg": null,
  "desc": "HealthKit clinical records (HKClinicalType) on iOS; Health Connect permissions on Android. Data stays on the device until you review it.",
  "header": {
    "t": "header",
    "title": "Connect",
    "left": "back",
    "pill": "Read-only"
  },
  "body": [
    {
      "t": "title",
      "text": "Use health data on this phone?",
      "size": "m"
    },
    {
      "t": "text",
      "text": "iPhone: Apple Health Records (FHIR) and readings. Android: Health Connect readings. You choose each type in the system screen next.",
      "tone": "muted"
    },
    {
      "t": "checklist",
      "items": [
        {
          "label": "Blood pressure"
        },
        {
          "label": "Blood glucose"
        },
        {
          "label": "Clinical records (iPhone)",
          "sub": "Labs, immunizations, conditions"
        },
        {
          "label": "Steps and sleep",
          "sub": "Not requested"
        }
      ],
      "label": "What Tether will ask for",
      "key": "data_types"
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Continue",
      "action": {
        "type": "branch",
        "question": "Anything selected?",
        "on": null,
        "decide": "rec.consent.device",
        "cases": [
          {
            "label": "Chosen",
            "action": {
              "type": "branch",
              "question": "System permission result",
              "on": null,
              "decide": null,
              "cases": [
                {
                  "label": "Allowed",
                  "action": {
                    "type": "push",
                    "to": "records_importing"
                  }
                },
                {
                  "label": "Not allowed",
                  "action": {
                    "type": "push",
                    "to": "records_error"
                  }
                }
              ],
              "id": "records.device.health_records_request",
              "ask": "healthRecordsRequest",
              "when": {
                "granted": "Allowed",
                "denied": "Not allowed",
                "unavailable": "Not allowed"
              }
            }
          },
          {
            "label": "Nothing chosen",
            "action": {
              "type": "toast",
              "value": "Select at least one item to continue."
            }
          }
        ]
      },
      "variant": "primary",
      "arrow": true
    },
    {
      "t": "button",
      "label": "Not now",
      "action": {
        "type": "back"
