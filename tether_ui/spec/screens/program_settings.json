{
  "id": "program_settings",
  "name": "Program settings",
  "route": "/p/:program/settings",
  "flow": "plans",
  "program": null,
  "phase": "account",
  "kind": "screen",
  "tab": null,
  "variantOf": null,
  "state": "default",
  "dark": false,
  "bg": null,
  "desc": "Parameterized by program. Shown here with BreatheFree data.",
  "header": {
    "t": "header",
    "title": "BreatheFree settings",
    "left": "back"
  },
  "body": [
    {
      "t": "list",
      "rows": [
        {
          "label": "BreatheFree",
          "sub": "Focus since Aug 14",
          "lead": {
            "program": "bf"
          }
        }
      ],
      "flat": true
    },
    {
      "t": "radio",
      "items": [
        {
          "label": "Focus",
          "sub": "Daily steps and reminders"
        },
        {
          "label": "Learn only",
          "sub": "Keep lessons, stop tracking"
        },
        {
          "label": "Pause",
          "sub": "Stop reminders; keep everything"
        }
      ],
      "selected": 0,
      "label": "Status",
      "key": "status"
    },
    {
      "t": "card",
      "variant": "plain",
      "eyebrow": "Sharing",
      "children": [
        {
          "t": "toggle",
          "label": "Care team · Dr. Patel’s clinic",
          "sub": "Manual: you approve each summary",
          "on": true,
          "key": "care_team_sharing"
        },
        {
          "t": "toggle",
          "label": "De-identified research",
          "on": false,
          "key": "de_identified_research"
        }
      ]
    },
    {
      "t": "list",
      "title": "Data",
      "rows": [
        {
          "label": "Export BreatheFree data",
          "sub": "PDF + JSON",
          "action": {
            "type": "toast",
            "value": "Export is being prepared. We’ll notify you."
          }
        },
        {
          "label": "Leave BreatheFree",
          "sub": "Keep your data or delete it now",
          "action": {
            "type": "sheet",
            "to": "account_leave"
          },
          "danger": true
        }
      ]
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Save changes",
      "action": {
        "type": "submit",
        "api": "PATCH /v1/enrolments/:id",
        "then": {
          "type": "toast",
          "value": "Saved",
          "then": {
            "type": "back"
          }
        }
      },
      "variant": "primary",
      "arrow": true
    }
  ],
  "notes": [],
  "over": null,
  "api": [
    "PATCH /v1/enrolments/:id"
  ],
  "actions": [
    {
      "element": "Back",
      "path": "header.left",
      "action": {
        "type": "back"
      },
      "summary": "back"
    },
    {
      "element": "Export BreatheFree data",
      "path": "body[3].rows[0]",
      "action": {
        "type": "toast",
        "value": "Export is being prepared. We’ll notify you."
      },
      "summary": "toast “Export is being prepared. We’ll notify you.”"
    },
    {
      "element": "Leave BreatheFree",
      "path": "body[3].rows[1]",
      "action": {
        "type": "sheet",
        "to": "account_leave"
      },
      "summary": "sheet → account_leave"
    },
    {
      "element": "Save changes",
      "path": "footer[0]",
      "action": {
        "type": "submit",
        "api": "PATCH /v1/enrolments/:id",
        "then": {
          "type": "toast",
          "value": "Saved",
          "then": {
            "type": "back"
          }
        }
      },
      "summary": "PATCH /v1/enrolments/:id then toast “Saved” then back"
    }
  ]
}
