{
  "id": "ca_symptoms",
  "name": "Symptom log",
  "route": "/p/ca/symptoms",
  "flow": "ca",
  "program": "ca",
  "phase": "daily",
  "kind": "screen",
  "tab": null,
  "variantOf": null,
  "state": "default",
  "dark": false,
  "bg": null,
  "desc": "",
  "header": {
    "t": "header",
    "title": "Log symptoms",
    "left": "back"
  },
  "body": [
    {
      "t": "title",
      "text": "What are you noticing?",
      "size": "m"
    },
    {
      "t": "chips",
      "options": [
        "Coughing",
        "Wheezing",
        "Short of breath",
        "Chest tightness",
        "Woke at night"
      ],
      "selected": [
        "Wheezing",
        "Woke at night"
      ],
      "multi": true,
      "key": "value"
    },
    {
      "t": "segmented",
      "options": [
        "Mild",
        "Moderate",
        "Severe"
      ],
      "selected": "Mild",
      "label": "How bad?",
      "key": "how_bad"
    },
    {
      "t": "chips",
      "options": [
        "Cold air",
        "Smoke",
        "Pollen",
        "Exercise",
        "Not sure"
      ],
      "selected": [
        "Cold air"
      ],
      "multi": true,
      "label": "Possible trigger",
      "key": "possible_trigger"
    },
    {
      "t": "field",
      "label": "Note (optional)",
      "placeholder": "Anything else to tell your clinician",
      "kind": "multiline",
      "key": "note_optional"
    }
  ],
  "footer": [
    {
      "t": "button",
      "label": "Save",
      "action": {
        "type": "submit",
        "api": "POST /v1/program-data/ca/symptoms",
        "then": {
          "type": "toast",
          "value": "Saved",
          "then": {
            "type": "back"
          }
        }
      },
      "variant": "primary",
      "arrow": true
    }
  ],
  "notes": [],
  "over": null,
  "api": [],
  "actions": [
    {
      "element": "Back",
      "path": "header.left",
      "action": {
        "type": "back"
      },
      "summary": "back"
    },
    {
      "element": "Save",
      "path": "footer[0]",
      "action": {
        "type": "submit",
        "api": "POST /v1/program-data/ca/symptoms",
        "then": {
          "type": "toast",
          "value": "Saved",
          "then": {
            "type": "back"
          }
        }
      },
      "summary": "POST /v1/program-data/ca/symptoms then toast “Saved” then back"
    }
  ]
}
