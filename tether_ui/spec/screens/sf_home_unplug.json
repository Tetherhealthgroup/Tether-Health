      "platform": "ios",
      "height": 132
    },
    {
      "t": "card",
      "variant": "dark",
      "eyebrow": "Yesterday · your estimate",
      "children": [
        {
          "t": "big",
          "value": "2h 10m",
          "caption": "Goal 90 min · down from 3h"
        }
      ]
    },
    {
      "t": "card",
      "variant": "coral",
      "title": "Urge to scroll?",
      "text": "Take 60 seconds first",
      "cta": {
        "t": "button",
        "label": "Pause 60",
        "action": {
          "type": "push",
          "to": "sf_pause"
        },
        "variant": "rescue",
        "arrow": false,
        "small": true
      }
    },
    {
      "t": "card",
      "variant": "mint",
      "title": "Unplug is on",
      "text": "2 groups · pause screen after 60 min",
      "action": {
        "type": "push",
        "to": "sf_unplug_home"
      }
    },
    {
      "t": "card",
      "variant": "plain",
      "eyebrow": "Today’s step",
      "children": [
        {
          "t": "checklist",
          "items": [
            {
              "label": "Charge your phone outside the bedroom",
              "sub": "Tonight · bedtime window 10 PM"
            }
          ]
        }
      ]
    },
    {
      "t": "list",
      "rows": [
        {
          "label": "This week",
          "sub": "5 of 7 phone-free nights",
          "action": {
            "type": "push",
            "to": "sf_week"
          }
        },
        {
          "label": "Had a long scroll?",
          "sub": "Reflect, nothing resets",
          "action": {
            "type": "push",
            "to": "sf_slip"
          }
        },
        {
          "label": "Goal & windows",
          "sub": "90 min · bedtime",
          "action": {
            "type": "push",
            "to": "sf_goal"
          }
        },
        {
          "label": "Buddy",
          "sub": "Sam · weekly message",
          "action": {
            "type": "push",
            "to": "sf_buddy"
          }
        },
        {
          "label": "Program settings",
          "sub": "Status, sharing, export, leave",
          "action": {
            "type": "push",
            "to": "program_settings"
          }
        }
      ]
    }
  ],
  "footer": [],
  "notes": [
    "TH-953 proposal for owner review (H32). Copy needs clinical/legal review.",
